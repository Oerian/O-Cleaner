# 运行数据 —— 不进版本库
history.json
schedule.json
disk-trend.json
receipts/
config/custom-rules.json
config/custom-overrides.json
# 用户自定义聚合组（占用树自由归组，本机数据）
config/fs-groups.json
# 资源包的启用状态与远端地址（本机选择，不该跟着仓库走）
config/packs-state.json
# 用户自己导入的资源包。内置包在 packs/，是仓库的一部分，不受这条影响。
config/packs-user/
# AI 设置：含 API 密钥，绝不进版本库
config/ai.json

# 本机真实测试用例（含本机真实目录名，绝不外发）
tools/local-cases.json

# 打包产物
dist/
# 免安装版构建缓存（官方 embeddable 运行时 zip，只下载一次）
build/

# 前身版本归档（dsh-cleaner/、clean-c-drive*.ps1、legacy 备份 zip）。
# 放在仓库目录内便于单目录集中管理，但**不属于本仓库**，永不提交。
_legacy/

# Python
__pycache__/
*.pyc
*.pyo

# 检查器产出的截图（文件名与 tools/cdp_check.js 里 writeFileSync 的三处一一对应）
tools/_ui_check.png
tools/_fs_check.png
tools/_partition_deep.png

# 临时/备份文件（自测与 linter 自测会临时产生）
*.tmp
*.bak
# 自测对 history/schedule 等状态文件做的安全备份（.<name>.backup）
*.backup
config/.targets.backup.json
config/.filetypes.linttest.bak

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store
.oc_write_probe_*

# 运行时状态（v2.8 起）：删除中断日志与跨进程锁文件
#   pending-deletes.json —— 删除中断时的暂存目录日志，启动时据此还原
#   .oc-history.lock     —— history 的跨进程文件锁
# 两者都随 --data-dir 落在数据目录；默认数据目录就是仓库根，必须忽略。
pending-deletes.json
.oc-*.lock
