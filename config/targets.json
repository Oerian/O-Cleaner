{
  "app": {
    "name": "O-Cleaner",
    "version": "test",
    "port": 51727
  },
  "presets": [
    {
      "id": "safe",
      "label": "测试预设",
      "desc": "只选无风险测试项",
      "select": {
        "risk": [
          "无"
        ]
      }
    },
    {
      "id": "pick",
      "label": "按 id 选",
      "desc": "验证显式 id 选择不被回收站过滤器清空",
      "select": {
        "ids": [
          "sandbox-tree"
        ]
      }
    },
    {
      "id": "none",
      "label": "全部取消",
      "desc": "取消所有勾选",
      "select": {
        "ids": []
      }
    }
  ],
  "targets": [
    {
      "id": "sandbox-tree",
      "label": "沙箱目录",
      "path": "%DRIVE%\\_ocleaner_selftest\\tree",
      "category": "测试",
      "risk": "无",
      "needs_admin": false,
      "kind": "tree",
      "short": "HTTP 端到端测试目录。",
      "what": "测试数据。",
      "rebuild": "测试。",
      "impact": "无。",
      "keep_if": "无。"
    },
    {
      "id": "sandbox-files",
      "label": "沙箱 glob",
      "path": "%DRIVE%\\_ocleaner_selftest\\files",
      "category": "测试",
      "risk": "无",
      "needs_admin": false,
      "kind": "files",
      "glob": "*.log",
      "short": "只删 .log。",
      "what": "测试数据。",
      "rebuild": "测试。",
      "impact": "无。",
      "keep_if": "无。"
    }
  ]
}