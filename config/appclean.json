{
  "version": 1,
  "apps": [
    {
      "id": "wechat",
      "name": "微信（3.x）",
      "bases": [
        "%USERPROFILE%\\Documents\\WeChat Files\\*",
        "%USERPROFILE%\\Documents\\WeChat Files",
        "%APPDATA%\\Tencent\\WeChat"
      ],
      "items": [
        {"sub": "FileStorage\\Cache", "kind": "cache", "label": "图片/缩略图缓存"},
        {"sub": "FileStorage\\MsgAttach", "kind": "cache", "label": "聊天图片缓存"},
        {"sub": "FileStorage\\Video", "kind": "data", "label": "聊天视频（按需清理）"},
        {"sub": "FileStorage\\File", "kind": "data", "label": "接收的文件（按月归档）"},
        {"sub": "FileStorage\\BackupFiles", "kind": "data", "label": "旧备份"},
        {"sub": "Msg", "kind": "core", "label": "聊天数据库（绝对不能删）"}
      ]
    },
    {
      "id": "wechat4",
      "name": "微信（4.x）",
      "bases": [
        "%USERPROFILE%\\Documents\\xwechat_files\\*"
      ],
      "items": [
        {"sub": "cache", "kind": "cache", "label": "运行与图片缓存"},
        {"sub": "temp", "kind": "cache", "label": "临时文件"},
        {"sub": "msg\\attach", "kind": "data", "label": "聊天附件与文件（按需清理）"},
        {"sub": "db_storage", "kind": "core", "label": "聊天数据库（绝对不能删）"}
      ]
    },
    {
      "id": "wxwork",
      "name": "企业微信",
      "bases": [
        "%APPDATA%\\WXWork",
        "%USERPROFILE%\\Documents\\WXWork\\*"
      ],
      "items": [
        {"sub": "Cache", "kind": "cache", "label": "缓存"},
        {"sub": "File\\Cache", "kind": "cache", "label": "文件缓存"},
        {"sub": "Avator", "kind": "cache", "label": "头像缓存"},
        {"sub": "Data", "kind": "core", "label": "账号与聊天数据库（勿动）"}
      ]
    },
    {
      "id": "qq",
      "name": "QQ（NT 版）",
      "bases": [
        "%LOCALAPPDATA%\\Packages\\*Tencent*QQ*\\LocalCache",
        "%USERPROFILE%\\Documents\\Tencent Files"
      ],
      "items": [
        {"sub": "nt_qq*\\FileStorage", "kind": "cache", "label": "消息图片缓存"}
      ]
    },
    {
      "id": "dingtalk",
      "name": "钉钉",
      "bases": [
        "%APPDATA%\\DingTalk",
        "%LOCALAPPDATA%\\DingTalk"
      ],
      "items": [
        {"sub": "Cache", "kind": "cache", "label": "浏览器与界面缓存"},
        {"sub": "GPUCache", "kind": "cache", "label": "GPU 渲染缓存"},
        {"sub": "logs", "kind": "cache", "label": "运行日志"}
      ]
    },
    {
      "id": "feishu",
      "name": "飞书 / Lark",
      "bases": [
        "%APPDATA%\\LarkShell",
        "%LOCALAPPDATA%\\LarkShell"
      ],
      "items": [
        {"sub": "Cache", "kind": "cache", "label": "界面缓存"},
        {"sub": "Code Cache", "kind": "cache", "label": "脚本编译缓存"},
        {"sub": "GPUCache", "kind": "cache", "label": "GPU 缓存"},
        {"sub": "logs", "kind": "cache", "label": "运行日志"}
      ]
    },
    {
      "id": "discord",
      "name": "Discord",
      "bases": [
        "%APPDATA%\\discord"
      ],
      "items": [
        {"sub": "Cache", "kind": "cache", "label": "媒体缓存"},
        {"sub": "Code Cache", "kind": "cache", "label": "脚本缓存"},
        {"sub": "GPUCache", "kind": "cache", "label": "GPU 缓存"}
      ]
    },
    {
      "id": "telegram",
      "name": "Telegram Desktop",
      "bases": [
        "%APPDATA%\\Telegram Desktop\\tdata"
      ],
      "items": [
        {"sub": "user_data\\cache", "kind": "cache", "label": "图片与媒体缓存"},
        {"sub": "user_data\\media_cache", "kind": "cache", "label": "视频/语音缓存"},
        {"sub": "emoji", "kind": "cache", "label": "表情包缓存"}
      ]
    },
    {
      "id": "jianying",
      "name": "剪映",
      "bases": [
        "%LOCALAPPDATA%\\JianyingPro"
      ],
      "items": [
        {"sub": "User Data\\Cache", "kind": "cache", "label": "草稿缓存"},
        {"sub": "User Data\\Cache\\user_texture_cache", "kind": "cache", "label": "贴纸/素材缓存"}
      ]
    },
    {
      "id": "vscode",
      "name": "VS Code",
      "bases": [
        "%APPDATA%\\Code"
      ],
      "items": [
        {"sub": "Cache", "kind": "cache", "label": "界面缓存"},
        {"sub": "CachedData", "kind": "cache", "label": "V8 编译缓存"},
        {"sub": "CachedExtensionVSIXs", "kind": "cache", "label": "旧版扩展安装包缓存"},
        {"sub": "logs", "kind": "cache", "label": "运行日志"}
      ]
    },
    {
      "id": "jetbrains",
      "name": "JetBrains IDE 缓存",
      "bases": [
        "%LOCALAPPDATA%\\JetBrains"
      ],
      "items": [
        {"sub": "*\\caches", "kind": "cache", "label": "索引与文件缓存（删后打开项目重建）"},
        {"sub": "*\\log", "kind": "cache", "label": "运行日志"}
      ]
    },
    {
      "id": "docker",
      "name": "Docker Desktop（WSL2 虚拟磁盘）",
      "bases": [
        "%LOCALAPPDATA%\\Docker"
      ],
      "items": [
        {
          "sub": "wsl\\data\\ext4.vhdx",
          "kind": "data",
          "label": "虚拟磁盘镜像",
          "advice": "镜像文件不能直接删。先 wsl --shutdown，再用 Optimize-VHD -Path <此文件> -Mode Full 压缩回收空间"
        }
      ]
    },
    {
      "id": "huggingface",
      "name": "HuggingFace 模型缓存",
      "bases": [
        "%USERPROFILE%\\.cache\\huggingface"
      ],
      "items": [
        {"sub": "hub", "kind": "data", "label": "已下载模型（按需删除，重下耗时较长）"}
      ]
    },
    {
      "id": "ollama",
      "name": "Ollama 本地模型",
      "bases": [
        "%USERPROFILE%\\.ollama"
      ],
      "items": [
        {
          "sub": "models",
          "kind": "data",
          "label": "已拉取模型",
          "advice": "建议用 ollama rm <模型名> 精确卸载，而不是手删"
        }
      ]
    },
    {
      "id": "pip",
      "name": "pip 包缓存",
      "bases": [
        "%LOCALAPPDATA%\\pip"
      ],
      "items": [
        {
          "sub": "cache",
          "kind": "cache",
          "label": "下载缓存",
          "advice": "也可 pip cache purge"
        }
      ]
    },
    {
      "id": "npm",
      "name": "npm / pnpm 缓存",
      "bases": [
        "%LOCALAPPDATA%\\npm-cache",
        "%LOCALAPPDATA%\\pnpm-cache"
      ],
      "items": [
        {
          "sub": "",
          "kind": "cache",
          "label": "包缓存",
          "advice": "也可 npm cache clean --force"
        }
      ]
    },
    {
      "id": "shader",
      "name": "Steam 着色器缓存",
      "bases": [
        "%PROGRAMFILES(x86)%\\Steam\\steamapps\\shadercache"
      ],
      "items": [
        {"sub": "", "kind": "cache", "label": "着色器缓存（删后首次进游戏会重建）"}
      ]
    }
  ]
}
